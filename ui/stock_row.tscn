[gd_scene format=3]

[ext_resource type="Theme" path="res://ui/autumn_theme.tres" id="theme"]
[ext_resource type="Script" path="res://scripts/stock_row.gd" id="script"]
[ext_resource type="Texture2D" path="res://assets/UIs/iconMagnifyingGlassesUi.png" id="mag"]
[ext_resource type="Texture2D" path="res://assets/UIs/iconCurseDetectorUi.png" id="curse"]

[sub_resource type="StyleBoxFlat" id="PriceBox"]
bg_color = Color(0.69, 0.53, 0.37, 1)

[node name="StockRow" type="HBoxContainer"]
custom_minimum_size = Vector2(0, 80)
theme = ExtResource("theme")
script = ExtResource("script")
theme_override_constants/separation = 24

[node name="Details" type="VBoxContainer" parent="."]
layout_mode = 2
size_flags_horizontal = 3
theme_override_constants/separation = 3

[node name="ArtifactName" type="RichTextLabel" parent="Details"]
layout_mode = 2
unique_name_in_owner = true
mouse_filter = 2
fit_content = true
bbcode_enabled = true
text = "Artifact name · Rare · 1 × 1"
scroll_active = false
theme_override_font_sizes/normal_font_size = 22

[node name="Cost" type="Label" parent="Details"]
layout_mode = 2
unique_name_in_owner = true
text = "Cost 100 G"
theme_override_font_sizes/font_size = 17

[node name="StatusRow" type="HBoxContainer" parent="Details"]
layout_mode = 2
theme_override_constants/separation = 10

[node name="Inspection" type="RichTextLabel" parent="Details/StatusRow"]
layout_mode = 2
unique_name_in_owner = true
size_flags_horizontal = 3
fit_content = true
bbcode_enabled = true
scroll_active = false
text = "Status: Normal"
theme_override_font_sizes/normal_font_size = 18

[node name="InspectDamageButton" type="Button" parent="Details/StatusRow"]
layout_mode = 2
unique_name_in_owner = true
visible = false
custom_minimum_size = Vector2(28, 28)
icon = ExtResource("mag")
expand_icon = true
tooltip_text = "Inspect with magnifying glass"
mouse_default_cursor_shape = 2

[node name="InspectCurseButton" type="Button" parent="Details/StatusRow"]
layout_mode = 2
unique_name_in_owner = true
visible = false
custom_minimum_size = Vector2(28, 28)
icon = ExtResource("curse")
expand_icon = true
tooltip_text = "Inspect with curse detector"
mouse_default_cursor_shape = 2

[node name="PriceColumn" type="VBoxContainer" parent="."]
layout_mode = 2
custom_minimum_size = Vector2(176, 0)
theme_override_constants/separation = 5

[node name="PricePrompt" type="Label" parent="PriceColumn"]
layout_mode = 2
text = "Set selling price"
horizontal_alignment = 1
theme_override_font_sizes/font_size = 20

[node name="PriceStack" type="Control" parent="PriceColumn"]
layout_mode = 2
custom_minimum_size = Vector2(176, 38)

[node name="EditPriceButton" type="Button" parent="PriceColumn/PriceStack"]
layout_mode = 1
anchor_left = 0
anchor_top = 0
anchor_right = 1
anchor_bottom = 1
text = ""
mouse_default_cursor_shape = 2
unique_name_in_owner = true
theme_override_styles/normal = SubResource("PriceBox")
theme_override_styles/hover = SubResource("PriceBox")
theme_override_styles/pressed = SubResource("PriceBox")
tooltip_text = "Click to edit. Enter saves; Escape cancels."

[node name="ListingPrice" type="SpinBox" parent="PriceColumn/PriceStack"]
layout_mode = 1
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
visible = false
unique_name_in_owner = true
min_value = 0.0
max_value = 60.0
step = 1.0
suffix = " G"
alignment = 1
theme_override_font_sizes/font_size = 26

[node name="SavePriceButton" type="Button" parent="PriceColumn"]
layout_mode = 2
unique_name_in_owner = true
visible = false
text = "Set"

